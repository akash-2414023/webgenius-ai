# WebGenius AI — Environment Configuration Example
PORT=5000
NODE_ENV=production

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Atlas Persistence
MONGODB_URI=your_mongodb_atlas_uri_here
MONGODB_DB_NAME=webgenius_ai

# Authentication & Session Security (32+ chars)
JWT_SECRET=your_production_jwt_secret_at_least_32_characters
SESSION_SECRET=your_production_session_secret_at_least_32_characters

# CORS & Production Frontend Origin
CLIENT_ORIGIN=https://webgenius-ui.onrender.com
FRONTEND_URL=https://webgenius-ui.onrender.com
