# WebGenius AI Server Configuration
PORT=5000
NODE_ENV=production

# Google Gemini API Key
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model: gemini-3.8-flash (recommended)
GEMINI_MODEL=gemini-3.8-flash

# CORS & Client URLs (Set to your production frontend URL on Render/Vercel)
CLIENT_ORIGIN=https://webgenius-ui.onrender.com
FRONTEND_URL=https://webgenius-ui.onrender.com

# MongoDB Atlas Configuration
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_uri_here
MONGODB_DB_NAME=webgenius_ai

# Authentication & Session Secrets (Use a 32+ character random string in production)
JWT_SECRET=your_production_jwt_secret_at_least_32_characters
SESSION_SECRET=your_production_session_secret_at_least_32_characters
